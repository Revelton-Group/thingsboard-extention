{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "hotel-dashboard": {
      "projectType": "library",
      "root": "src/hotel-dashboard",
      "sourceRoot": "src/hotel-dashboard",
      "prefix": "tb",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "src/hotel-dashboard/tsconfig.lib.json",
            "project": "src/hotel-dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "src/hotel-dashboard/tsconfig.lib.json"
            },
            "development": {
              "tsConfig": "src/hotel-dashboard/tsconfig.lib.json",
              "project": "src/hotel-dashboard/ng-package.dev.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/hotel-dashboard/**/*.ts",
              "src/hotel-dashboard/**/*.html"
            ]
          }
        }
      }
    },
    "utility-dashboard": {
      "projectType": "library",
      "root": "src/utility-dashboard",
      "sourceRoot": "src/utility-dashboard",
      "prefix": "tb",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "src/utility-dashboard/tsconfig.lib.json",
            "project": "src/utility-dashboard/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "src/utility-dashboard/tsconfig.lib.json"
            },
            "development": {
              "tsConfig": "src/utility-dashboard/tsconfig.lib.json",
              "project": "src/utility-dashboard/ng-package.dev.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/utility-dashboard/**/*.ts",
              "src/utility-dashboard/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "packageManager": "yarn",
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
